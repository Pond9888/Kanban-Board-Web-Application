# Anthropic API key (required for AI features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# For mobile builds (Capacitor): set this to your deployed backend URL
# Example: https://your-app.vercel.app
# Leave empty for web development (relative URLs are used)
NEXT_PUBLIC_API_BASE_URL=

# RevenueCat Android API Key (สำหรับ Google Play Billing)
# ได้จาก https://app.revenuecat.com → Project → API Keys → Public app-specific key (Android)
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Optional: Vercel deployment URL (auto-set by Vercel)
NEXT_PUBLIC_VERCEL_URL=
